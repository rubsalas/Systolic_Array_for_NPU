`timescale 1 ps/ 1 ps

module vjtag (
	altera_reserved_tms,
	altera_reserved_tck,
	altera_reserved_tdi,
	altera_reserved_tdo,
	tdi,
	tdo,
	ir_in,
	ir_out,
	virtual_state_cdr,
	virtual_state_sdr,
	virtual_state_e1dr,
	virtual_state_pdr,
	virtual_state_e2dr,
	virtual_state_udr,
	virtual_state_cir,
	virtual_state_uir,
	tck);
input 	altera_reserved_tms;
input 	altera_reserved_tck;
input 	altera_reserved_tdi;
output 	altera_reserved_tdo;
output 	tdi;
input 	tdo;
output 	[0:0] ir_in;
input 	[0:0] ir_out;
output 	virtual_state_cdr;
output 	virtual_state_sdr;
output 	virtual_state_e1dr;
output 	virtual_state_pdr;
output 	virtual_state_e2dr;
output 	virtual_state_udr;
output 	virtual_state_cir;
output 	virtual_state_uir;
output 	tck;

